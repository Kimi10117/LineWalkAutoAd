<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_light"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="90dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 頂部橫幅 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_sleek"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="散步趣助手"
                    android:textColor="@color/card_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_version_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="v1.15.80"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="LINE 散步趣專用 ‧ 全自動視覺辨識 ‧ 全螢幕比例自適應"
                android:textColor="#E8F5E9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 卡片 1：權限狀態與啟動懸浮窗 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_sleek"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一、必要權限與啟動控制"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="檢查權限狀態中..."
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <!-- Android 13+ 受限制設定防呆提示盒 -->
            <LinearLayout
                android:id="@+id/layoutRestrictedHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_restricted_hint"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[提示] 首次開啟若遇「受限制的設定」："
                    android:textColor="#B45309"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="1. 點下方 [開啟無障礙服務] 並點擊「散步趣助手」\n2. 點下方橘色按鈕跳轉至應用程式資訊\n3. 點右上角「⋮」(三個直點) -> 選擇「允許受限制的設定」"
                    android:textColor="#78350F"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUnlockRestricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#F59E0B"
                    android:text="解鎖「受限制的設定」(跳轉應用程式資訊)"
                    android:textColor="@color/card_white"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="1. 開啟無障礙服務"
                    android:textColor="@color/card_white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEnableOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="2. 授權懸浮窗權限"
                    android:textColor="@color/card_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStartOverlayAndGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/line_green"
                android:paddingVertical="12dp"
                android:text="啟動懸浮窗並打開《LINE 散步趣》"
                android:textColor="@color/card_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 卡片 2：自動化任務模組與運行參數設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_sleek"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二、自動巡邏順序與運行設定 (移動 -> 時間 -> 遊戲 -> 步數)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbMoveGauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1.【移動】移動距離獎勵 (第一優先領取金幣)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbIdleReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.【時間】優先看廣告獲莓果與收成獎勵 (第二順位)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbGachaTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.【遊戲】觀看廣告抽獎獎勵 (第三順位)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbStepBottle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.【步數】水瓶集滿領取票券獎勵 (第四順位)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="次要功能與日常任務"
                android:textColor="@color/line_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbBingoTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5.【賓果】開啟賓果格與連線 Get 獎勵 (第五順位)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbLotteryTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6.【抽抽樂】優先 50 抽 / 免費抽 / 5 張抽 1 次"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbDailyMissionTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7.【任務】特別與每日任務獎勵領取 (第七順位)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbFriendGiftTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8.【好友送禮】排行榜自動送禮 (優先送自己)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbReceiveGiftTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9.【接收禮物】自動開啟禮物盒領取好友禮物"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="#E2E8F0" />

            <CheckBox
                android:id="@+id/cbClaimNormalWhenNoAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自動關閉推銷彈窗 (跳過) 與無廣告一般領取"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#E2E8F0" />

            <!-- 廣告卡死強制退回計時器 (40s ~ 90s) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="廣告卡死強制退回計時器"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaxAdWaitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65 秒"
                    android:textColor="@color/line_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="單支廣告超過此時限仍未關閉，將強制按返回並拉回遊戲 (40s ~ 90s)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDecreaseAdWait"
                    android:layout_width="48dp"
                    android:layout_height="34dp"
                    android:backgroundTint="#E2E8F0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="-5s"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarMaxAdWait"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:max="50"
                    android:progress="25" />

                <Button
                    android:id="@+id/btnIncreaseAdWait"
                    android:layout_width="48dp"
                    android:layout_height="34dp"
                    android:backgroundTint="#E2E8F0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+5s"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#E2E8F0" />

            <!-- 巡邏掃描速度 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="巡邏掃描速度"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="調整畫面偵測間隔，平衡反應速度與手機耗電"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSpeedFast"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E2E8F0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="極速 1000ms"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnSpeedNormal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/line_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="標準 1200ms"
                    android:textAllCaps="false"
                    android:textColor="@color/card_white"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSpeedEco"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E2E8F0"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="省電 1500ms"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片 3：即時狀態與執行日誌 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_sleek"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三、即時狀態與執行日誌"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbFilterErrorStatusLogs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="僅看異常／狀態"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#64748B"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="清空日誌"
                    android:textColor="@color/card_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_terminal_box"
                android:fontFamily="monospace"
                android:minLines="7"
                android:padding="12dp"
                android:text="尚無執行紀錄..."
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExportLogs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#0284C7"
                    android:text="@string/btn_export_logs"
                    android:textColor="@color/card_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:text="@string/btn_copy_logs"
                    android:textColor="@color/card_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- 底部版本更新提示卡片 (預設隱藏，檢測到新版本時平滑浮現) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUpdateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- 標題與說明文字 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUpdateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="發現新版本！"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUpdateVersionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_version_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="v1.15.75"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUpdateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="已有最新穩定版本，點擊立即前往下載。"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 前往下載按鈕 -->
            <Button
                android:id="@+id/btnDownloadUpdate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#059669"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="前往下載"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 關閉按鈕 -->
            <ImageView
                android:id="@+id/btnCloseUpdateBanner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#64748B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
